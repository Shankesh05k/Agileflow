# ──────────────────────────────────────────────────────────
# AgileFlow — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env file.
# ──────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agileflow
POSTGRES_USER=agileflow
POSTGRES_PASSWORD=change_me

# Full connection URL (takes precedence over individual vars)
DATABASE_URL=postgres://agileflow:change_me@localhost:5432/agileflow

# ── JWT ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=c7a20b869e3758fc4950859a7077646b2cc230db843948a054136a15c65004cc3fa3455e916ad8c7553ed6095d44cb15
JWT_REFRESH_SECRET=afa99d295bca29c19d12cfc3ab6e23477d94e4426e16d06e9e52ff28e7b995fc07e659d4af1d1851b931febd66395a16


# Token lifetimes (ms-style strings: 15m, 7d, 1h, etc.)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# CORS — space-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ── Frontend (Vite) ───────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000/api

# ── AI ticket-draft assistant (Groq, free tier) ───────────
# Get a free key, no card required: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Docker Compose (used by docker-compose.yml) ───────────
# These mirror the Postgres vars above; keep them in sync.
DOCKER_POSTGRES_USER=agileflow
DOCKER_POSTGRES_PASSWORD=change_me
DOCKER_POSTGRES_DB=agileflow